# Copy to .env. Generate random secrets with: python3 scripts/generate_env.py
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
CODEINTENT_API_SECRET=
CODEINTENT_OPERATOR_TOKEN=
CODEINTENT_SESSION_SECRET=
# Your public HTTPS origin. localhost is suitable for the local Compose preview.
CODEINTENT_PUBLIC_URL=http://localhost:3000
CODEINTENT_PORT=3000
CODEINTENT_BIND=127.0.0.1
# Optional bundled HTTPS proxy: point this domain at your server.
CODEINTENT_DOMAIN=

# Vertex authentication: choose ONE method. No credentials are sent to the browser.
# Method A: Vertex Express Mode API key.
GOOGLE_API_KEY=
# Method B: attached Google Cloud identity / ADC (recommended for managed Google Cloud).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Method C: service-account file mounted read-only at this path (native/managed deploy).
GOOGLE_APPLICATION_CREDENTIALS=
# Local development only: refer to an existing .env outside the repository.
CODEINTENT_VERTEX_ENV_FILE=
VERTEX_GENERATION_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
# Optional public-read GitHub token. Strongly recommended to avoid anonymous API limits.
GITHUB_TOKEN=

# Native / managed deployment only. Compose supplies internal service addresses.
DATABASE_URL=postgresql://codeintent:CHANGE_ME@127.0.0.1:5442/codeintent
NEO4J_URI=bolt://127.0.0.1:7692
NEO4J_USERNAME=neo4j
CODEINTENT_API_URL=http://127.0.0.1:8210
CODEINTENT_ENV=production
CODEINTENT_QUESTIONS_PER_DAY=30
CODEINTENT_GLOBAL_QUESTIONS_PER_DAY=300
CODEINTENT_IMPORTS_PER_DAY=20
