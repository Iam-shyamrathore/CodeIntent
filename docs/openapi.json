  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportRequest": {
        "properties": {
          "repository": {
            "type": "string",
            "title": "Repository"
          },
          "limit": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 12
          },
          "pull_requests": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Pull Requests"
          },
          "issues": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "repository"
        ],
        "title": "ImportRequest"
      },
      "Question": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 800,
            "minLength": 8,
            "title": "Question"
          },
          "index_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{24}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Index Id"
          },
          "repository": {
            "type": "string",
            "title": "Repository",
            "default": "encode/httpx"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "Question"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
