FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 app
COPY codeintent ./codeintent
COPY scripts ./scripts
COPY migrations ./migrations
COPY fixtures/corpus ./fixtures/corpus
USER app
CMD ["sh", "-c", "exec uvicorn codeintent.api:app --host 0.0.0.0 --port ${PORT:-8210} --no-access-log"]
